# Mathketeers — optional Supabase persistence (Phase 4)
#
# Leave these unset and the app saves progress to the browser's localStorage
# (works out of the box). Set BOTH to switch to cloud saves via Supabase:
#
#   1. Create a Supabase project.
#   2. Run supabase/schema.sql in the SQL editor.
#   3. Copy this file to `.env.local` and fill in the values from
#      Project Settings → API.
#
# Only VITE_-prefixed vars are exposed to the client bundle. The anon key is a
# public, RLS-gated key — never put a service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
